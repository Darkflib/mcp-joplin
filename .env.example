JOPLIN_TOKEN=REPLACE_ME
JOPLIN_BASE_URL=http://127.0.0.1:41184

# MCP HTTP server (`serve`; not needed for `stdio`)
# At least 12 characters. Generate one with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
MCP_API_KEY=REPLACE_ME
MCP_HOST=127.0.0.1
MCP_PORT=5005

# Only offer tools that read the notebook (no create/edit/delete).
MCP_READ_ONLY=false

# Largest attachment resources_read / joplin-resource:// will return (bytes; 10 MiB).
MCP_MAX_ATTACHMENT_BYTES=10485760

# Poll Joplin for note changes while a client is listening (seconds; 0 = off).
MCP_EVENTS_POLL_SECONDS=5
